; Output: SKIP.M
; Console: SKIP.OUT
; PMDMML.MAN §16-2

#Title SKIP
#Option /v/c

; §16-2 MML Skip Control 1 (")
A c " d e f " g         ; MML Skip inline ('" toggles skipping notes/rests)
"                       ; Skip start (block) - uncomment if needed
A d e                   ; Skipped
B f g                   ; Skipped
"                       ; Skip end (block) - uncomment if needed
A a b                   ; Not skipped

; §16-3 MML Skip Control 2 (')
A c " d e f ' g a       ; Forcibly end skip started by "

; Part A: basic notes before block skip
A c d e f

; Block-level " skip (cmloop2): toggles skip for entire lines
"
A g a b >c
"

; This line compiles normally after skip is toggled off
A <d e f

; Block-level ' to forcibly end skip started by "
"
A a b
'
A >c d e

; Exercise " skip mode with various constructs inside
; " toggles skip, notes/ties/lengths/portamento/arpeggio inside skip are parsed but not emitted
A c d " e&4 f4 {g >c}4 {{ceg}}4,16,0,8,-2 =8 ^2 r4 ' a b

; Portamento in skip mode
A " {c g}4 " c d

; More " skip with length rewrite
A c4 " =8 d4 +4 " e f

; --- Part I: Skip/comment controls ---
; " toggle skip
I @1 c " d e f " g
; ' force end skip
I c " d e f ' g a

; --- Part C: Accent in skip context ---
; " ... " skip with ^) accent exercises bp8 acc_adr path
C @1 v10 " ^)1 c " d e
