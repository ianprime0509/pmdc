; Output: RHYTHM.M
; Console: RHYTHM.OUT
; PMDMML.MAN §1-1-2, §1-2-1, §1-2-2, §1-2-3, §6-1-3, §6-1-4, §6-7, §14-1, §14-2, §14-3, §14-4

#Title RHYTHM
#Option /v/c

; Define simple SSG drum patterns in R part and play via K part
K   R0 L [R1]2 R2
R0  l16[@64c]4               ; SSG drum hits
R1  l8 @1c@128c@2c@128c      ; Alternating drums
R2  l8 @2c@2c@1c@1c           ; Ending roll

; YM2608 rhythm sound source commands in an SSG rhythm part (K)
K   \V63\vs31\vb31\vh15\vt31   ; rhythm volumes
K   R3 L [R4]2 R5
R3  l16[\sr]4
R4  l8 \br\hr\sr\hr
R5     \br\tr\tr\tr

; Additional rhythm mixes to exercise more commands and parts
K   R6 L [R7]3 R8
R6  l16 \br \sr \hr \tr      ; mixed hits
R7  l8  \hr\vh-6 \hr\vh+6     ; volume mod on hi-hat
R8  l8  \br\vh-4 \tr \sr      ; tom/snare variation

; Use alternate R definitions with tied playback and repeats
K   R9 L [R10]2 [R11]
R9  l8  \br r \sr r           ; spaced hits
R10 l16 \tr \tr \hr \sr       ; fast fill
R11 l8  \br\hr\sr\tr          ; ending fill

; More rhythm voices (crash/ride/toms) and dynamic changes
K   R12 L [R13]2 [R14]2 R15
R12 l16 \cr \cr \br \sr       ; crash accents with bass+snare
R13 l8  \hr\vh-8 \hr\vh+8      ; alternating hat levels
R14 l8  \tr \tr \cr \br        ; toms with crash
R15 l8  \sr\vh-4 \sr\vh+4 \br  ; snare swells with bass

; Rhythm with pauses and mixed spacing
K   R16 L [R17]2 R18
R16 l16 \br r \sr r \hr r \tr r
R17 l8  r \br r \cr r \sr      ; rests interleaved
R18 l8  \hr\vh-10 \hr\vh+10 \tr ; hat swells and tom

; Basic melody line for reference
A t120 o4 v12 c d e f g a b>c<

; --- §14 MML Commands - Rhythm Sound Source Commands --- (Can be in any part, K used for convention)

; §14-1 Rhythm Sound Source Shot/Dump Control (\b \s \c \h \t \i, \bp etc.)
K \b \s \h l4 \c \t \i  ; Rhythm Source Trigger (BD, SN, HH, then CY, TOM, RIM)
K \b\s\h l4             ; Trigger multiple simultaneously
K \cp l4 \hp            ; Rhythm Source Dump (stop Cymbal, HiHat)

; §14-2 Rhythm Sound Source Master Volume Setting (\V)
K \V63 \b \V-10 \s \V+5 \c ; Rhythm Master Volume (0-63, absolute, +/- relative)

; §14-3 Rhythm Sound Source Individual Volume Setting (\vb \vs \vc \vh \vt \vi)
K \vb31 \b \vs+2 \s \vc-5 \c \vh15 \vt10 \vi20 ; Rhythm Individual Volume (0-31, absolute, +/- relative)

; §14-4 Rhythm Sound Source Output Position Setting (\lb \mb \rb etc.)
K \lb \b \rs \s \mc \c \mh \h \mt \t \li \i ; Rhythm Panning (l=left, m=mid, r=right)

; --- Part A: Rhythm source edge cases ---
; Rhythm trigger, dump, volume, pan
K \V63 \b \s \h l4 \c \t \i
K \b\s\h l4
K \cp l4 \hp
K \V-10 \b \V+5 \s
K \vb31 \b \vs+2 \s \vc-5 \c
K \vh15 \vt10 \vi20 \h \t \i
K \lb \b \rs \s \mc \c \mh \h

; Rhythm dump with 'p' suffix
K l4 \b \sp \cp \hp

; Rhythm notes for rhythm press paths
K l4 \b \b \s \s \c \c

; --- Rhythm dump with p suffix (rs00) ---
K " \bp \sp " l4 \b \s \c

; §6-1-3: every SSG drum tone number, and combined values
K   R19 L [R20]2 R21
R19 l8 @1c @2c @4c @8c @16c @32c @64c @128c @256c @512c @1024c
R20 l8 @3c @6c @192c @1536c
R21 l8 @1024c @512c @256c

; §6-1-4: SSG PCM tone numbers available with PPSDRV resident
K   R22 L [R23]2 R24
R22 l8 @2048c @4096c @8192c
R23 l8 @2049c @4098c @8194c
R24 l8 @6144c @12288c

; §1-2-3: K/R SSG rhythm uses SSG channel 3, the same channel as I.
; The key-on conflict is a runtime behavior; this case verifies both parts compile.
I @1 v10 l8 c d e f g a b
