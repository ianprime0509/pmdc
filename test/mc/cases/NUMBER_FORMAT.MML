; Output: NUMBER_FORMAT.M
; Console: NUMBER_FORMAT.OUT
; PMDMML.MAN §1-3

#Title NUMBER_FORMAT
#Option /v/c

; --- Part F: Hex and percent number parsing ---
; Hex values with $
F @1 v$0f c V$7f d t$78 e
; Percent lengths
F c%24 d%12 e%6 f%48 g%96

; Hex length parsing ($) to trigger hexget8/hexcal8
A l$10 c d e

; Simple tempo with hex
A t$3c c d e
