; Output: VOLUME_DOWN.M
; Console: VOLUME_DOWN.OUT
; PMDMML.MAN §2-22, §2-23, §15-4, §15-10

#Title VOLUME_DOWN
#Option /v/c

; §15-4 Sound Source Specific Volume Down Setting (DF DS DP DR)
A DF+8 c DS-4 d DP128 e DR+16 f ; Sound source volume down set (+/- relative, absolute)

; Absolute voldown for FM/SSG/Rhythm (flag=1 -> 0xff/0xfd/0xf9)
; Relative PPZ voldown (flag=0 -> 0xf5)
#Volumedown F8,S4,R2,Z+3

; ADPCM flag to trigger 0xc0,0xf7 path on PCM part
#ADPCM ON

; FM part - exercises DF inline (absolute -> subcmd+1)
A @1 v12 l4 c DF8 d DS4 e DP+2 f DR2 g DZ+1 a

; SSG part
G @1 v10 l4 c d e f

; PCM part (triggers adpcm_flag output)
J @0 v10 l4 c d e f

; Rhythm part
K l4 \V32 \b \s \c \h

; Hit VolDown_set with multiple flags, absolute and relative (macro requires two chars after #)
#VA FS+3,PR-2,Z16

; Exercise volume set paths (relative, absolute, bracketed)
A l4 v10 c v+2 d v-4 e v(2 f v)1 g ) a ( b

; Tie and simple loop
A c&c
A l8 [c d]2

; Tempo hex and q-range
A t$3c q2-4 c d e

; --- Part D: Volume down settings ---
D @1 DF+8 c DS-4 d DP128 e DR+16 f
D DF0 c DS0 d DP0 e DR0 f
